hypervisor:
  vars:
    ansible_python_interpreter: /usr/bin/python3
  hosts:
    pxe-playground:
      ansible_host: <ip>
      ansible_user: <user>
      ansible_ssh_private_key_file: ~/.ssh/<key_name>

pxe_server:
  vars:
    ansible_python_interpreter: /usr/bin/python3
  hosts:
    pxe-server:
      ansible_host: <ip>
      ansible_user: debian
      ansible_ssh_private_key_file: ~/.ssh/<key_name>
      ansible_ssh_common_args: -o ProxyCommand="ssh -i ~/.ssh/<key_name> -W %h:%p <hypervisor_user>@<hypervisor_ip>"
