hypervisor:
  vars:
    ansible_python_interpreter: /usr/bin/python3
  hosts:
    pxe-playground:
      ansible_host: <ip>
      ansible_user: <user>
      ansible_ssh_private_key_file: ~/.ssh/<key_name>

pxe_server:
  vars:
    ansible_python_interpreter: /usr/bin/python3
  hosts:
    pxe-server:
      ansible_host: <ip>
      ansible_user: debian
      ansible_ssh_private_key_file: ~/.ssh/<key_name>
      ansible_ssh_common_args: -o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -i ~/.ssh/<key_name> -W %h:%p <hypervisor_user>@<hypervisor_ip>"

pxe_client:
  vars:
    ansible_python_interpreter: /usr/bin/python3
  hosts:
    pxe-client:
      ansible_host: 10.0.0.10
      mac: "52:54:00:00:00:01"
      ansible_user: debian
      ansible_ssh_private_key_file: ~/.ssh/<key_name>
      ansible_ssh_common_args: -o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -i ~/.ssh/<key_name> -o StrictHostKeyChecking=accept-new -o 'ProxyCommand=ssh -i ~/.ssh/<key_name> -W %%h:%%p <hypervisor_user>@<hypervisor_ip>' -W %h:%p debian@<pxe_server_ip>"
